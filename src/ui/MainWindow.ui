  <widget class="QDockWidget" name="dockTargetSettings">
   <property name="features">
    <set>QDockWidget::DockWidgetClosable</set>
   </property>
   <property name="windowTitle">
    <string>Target Settings</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>1</number>
   </attribute>
   <widget class="QWidget" name="dockContentSettings">
    <layout class="QVBoxLayout" name="layoutSettings">
     <property name="leftMargin">
      <number>8</number>
     </property>
     <property name="topMargin">
      <number>8</number>
     </property>
     <property name="rightMargin">
      <number>8</number>
     </property>
     <property name="bottomMargin">
      <number>6</number>
     </property>
     <item>
      <widget class="QGroupBox" name="groupDevice">
       <property name="title">
        <string>Device</string>
       </property>
       <layout class="QFormLayout" name="formDevice">
        <item row="0" column="0">
         <widget class="QLabel" name="lblManufacturer">
          <property name="text">
           <string>Manufacturer</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboManufacturer"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lblModel">
          <property name="text">
           <string>Model</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="comboModel">
          <property name="editable">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupConnection">
       <property name="title">
        <string>Connection</string>
       </property>
       <layout class="QFormLayout" name="formConnection">
        <item row="0" column="0">
         <widget class="QLabel" name="lblProbe">
          <property name="text">
           <string>Probe</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboProbe"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lblInterface">
          <property name="text">
           <string>Interface</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="comboInterface">
          <item>
           <property name="text">
            <string>SWD</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>JTAG</string>
           </property>
          </item>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="lblSpeed">
          <property name="text">
           <string>Speed</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboSpeed">
          <property name="toolTip">
           <string>Clock of the debug link. The probe uses the closest speed it supports (an ST-Link V2 reaches at most 4 MHz). Lower it when the connection is unstable.</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupOptions">
       <property name="title">
        <string>Options</string>
       </property>
       <layout class="QVBoxLayout" name="layoutOptions">
        <item>
         <widget class="QCheckBox" name="checkEraseBeforeFlash">
          <property name="text">
           <string>Erase chip before programming</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkVerifyAfterFlash">
          <property name="text">
           <string>Verify after programming</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkResetAfterFlash">
          <property name="text">
           <string>Reset and run after programming</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkConnectUnderReset">
          <property name="text">
           <string>Connect under reset</string>
          </property>
          <property name="toolTip">
           <string>Hold the target in reset while connecting. Helps when the chip sleeps, runs code that disables the debug pins, or cannot be reached otherwise.</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupFirmwareSlots">
       <property name="title">
        <string>Firmware Files</string>
       </property>
       <layout class="QVBoxLayout" name="layoutSlots">
        <item>
         <widget class="QLabel" name="lblSlot1Title">
          <property name="text">
           <string>File 1</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="layoutSlot1Row">
          <item>
           <widget class="QPushButton" name="btnOpenSlot1">
            <property name="text">
             <string>Open</string>
            </property>
            <property name="maximumWidth">
             <number>60</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="editSlot1Path">
            <property name="placeholderText">
             <string>Select firmware file...</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="editSlot1Address">
            <property name="text">
             <string>0x08000000</string>
            </property>
            <property name="toolTip">
             <string>Start address (used for .bin files; HEX files carry their own addresses)</string>
            </property>
            <property name="maximumWidth">
             <number>90</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QLabel" name="lblSlot2Title">
          <property name="text">
           <string>File 2</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="layoutSlot2Row">
          <item>
           <widget class="QPushButton" name="btnOpenSlot2">
            <property name="text">
             <string>Open</string>
            </property>
            <property name="maximumWidth">
             <number>60</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="editSlot2Path">
            <property name="placeholderText">
             <string>Select firmware file...</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="editSlot2Address">
            <property name="text">
             <string>0x08008000</string>
            </property>
            <property name="toolTip">
             <string>Start address (used for .bin files; HEX files carry their own addresses)</string>
            </property>
            <property name="maximumWidth">
             <number>90</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </widget>
  </widget>
