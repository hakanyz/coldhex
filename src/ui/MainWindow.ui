    <item>
     <widget class="QGroupBox" name="groupMemoryViewer">
      <property name="title">
       <string>HEX Memory Table Viewer</string>
      </property>
      <layout class="QVBoxLayout" name="layoutMemoryViewer">
       <item>
        <layout class="QHBoxLayout" name="layoutMemoryHeader">
         <item>
          <widget class="QLabel" name="lblMemoryMapTitle">
           <property name="font">
            <font>
             <weight>75</weight>
             <bold>true</bold>
            </font>
           </property>
           <property name="text">
            <string>Memory Map</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="spacerMemoryHeader">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QGroupBox" name="groupDataSource">
           <property name="title">
            <string>Data Source</string>
           </property>
           <layout class="QHBoxLayout" name="layoutDataSource">
            <property name="topMargin">
             <number>2</number>
            </property>
            <property name="bottomMargin">
             <number>2</number>
            </property>
            <item>
             <widget class="QRadioButton" name="radioSourceFile1">
              <property name="text">
               <string>File 1</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="radioSourceFile2">
              <property name="text">
               <string>File 2</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="radioSourceBoth">
              <property name="text">
               <string>File 1 + File 2</string>
              </property>
              <property name="toolTip">
               <string>Program and Verify write both files (e.g. bootloader + application). The memory view shows File 1.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="radioSourceTarget">
              <property name="text">
               <string>Read from Target</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QTableView" name="tableMemory">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>160</height>
          </size>
         </property>
         <property name="font">
          <font>
           <family>Consolas</family>
           <pointsize>9</pointsize>
